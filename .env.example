# Copy to .env and fill in. .env is gitignored — keep real endpoints out of git.

AWS_REGION=ap-northeast-3
AWS_PROFILE=your-aws-profile

# Databases pgbouncer should expose, one per row.
# rows separated by ';', fields by '|':  alias|host|port|dbname|iam-db-user
# The alias is what you pass to psql -d; it is not the real dbname.
PG_DATABASES="scraper|your-instance.xxxxxxxx.ap-northeast-3.rds.amazonaws.com|5432|your_db|you@example.com"

# Optional
PGBOUNCER_LISTEN_PORT=6432
PGBOUNCER_REFRESH_SECONDS=600
# Absolute path; defaults to $HOME/.aws/rds-global-bundle.pem
#RDS_CA_FILE=/Users/you/.aws/rds-global-bundle.pem
